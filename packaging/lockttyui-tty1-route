#!/bin/sh
# Only root-owned systemd units call this helper. Never execute agetty here.
set -eu
umask 077

event() { printf "LOCKTTYUI_EVENT=%s\n" "$1" >&2; }
state=/run
systemctl=/usr/bin/systemctl
token="$state/lockttyui-tty1-login.ready"
fallback="$state/lockttyui-tty1-fallback"
removing="$state/lockttyui-tty1-removing"
dropdir="$state/systemd/system/getty@tty1.service.d"
dropin="$dropdir/90-lockttyui-fallback.conf"

allowed() {
  [ ! -e "$removing" ] || return 1
  phase=$("$systemctl" is-system-running 2>/dev/null || :)
  case "$phase" in stopping|offline) return 1 ;; esac
  return 0
}

start_getty() {
  allowed || return 0
  : > "$token"
  allowed || return 0
  "$systemctl" --no-block start getty@tty1.service
}

native_fallback() {
  allowed || return 0
  # Do not reconfigure routing while getty may own tty1 or be starting.
  getty_state=$("$systemctl" show -p ActiveState --value getty@tty1.service) || return 1
  case "$getty_state" in inactive|failed) ;; *) event GETTY_NOT_INACTIVE; return 0 ;; esac
  allowed || return 0
  event FALLBACK_SELECTED
  : > "$fallback"
  : > "$token"
  # Native restart, not a loop of OnSuccess/OnFailure callbacks. Only tty1
  # receives this ephemeral override; all vendor authentication commands stay.
  mkdir -p "$dropdir"
  tmp=$(mktemp "$dropdir/.lockttyui-fallback.XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  cat > "$tmp" <<'CONF'
[Unit]
OnSuccess=
OnFailure=
StartLimitIntervalSec=0

[Service]
Restart=always
RestartSec=3s
CONF
  allowed || return 0
  mv -f "$tmp" "$dropin"
  "$systemctl" daemon-reload
  allowed || return 0
  "$systemctl" reset-failed getty@tty1.service || :
  start_getty
}

allowed || exit 0

case "${1:-}" in
  handoff|fallback)
    current=$("$systemctl" show -p ActiveState --value lockttyui-tty1.service)
    case "$current" in inactive|failed) ;; *) exit 0 ;; esac
    if [ "$1" = fallback ] || [ -e "$fallback" ]; then
      native_fallback
    else
      start_getty
    fi
    ;;
  return)
    current=$("$systemctl" show -p ActiveState --value getty@tty1.service)
    case "$current" in inactive|failed) ;; *) event GETTY_NOT_INACTIVE; exit 0 ;; esac
    # systemd >=251 provides raw status to a handler of exactly one unit.
    # Missing, killed, or nonzero status is not a proven clean logout.
    if [ ! -e "$fallback" ] && [ "$current" = inactive ] &&
       [ "${MONITOR_UNIT:-}" = getty@tty1.service ] &&
       [ "${MONITOR_SERVICE_RESULT:-}" = success ] &&
       [ "${MONITOR_EXIT_CODE:-}" = exited ] &&
       [ "${MONITOR_EXIT_STATUS:-}" = 0 ]; then
      allowed || exit 0
      event RETURN_CLEAN
      rm -f "$token"
      allowed || exit 0
      if "$systemctl" --no-block start lockttyui-tty1.service; then
        event DASHBOARD_START_QUEUED
      else
        event DASHBOARD_START_REQUEST_FAILED
        exit 1
      fi
    else
      if [ -e "$fallback" ]; then event RETURN_FALLBACK_ALREADY_ACTIVE
      elif [ "$current" != inactive ]; then event RETURN_GETTY_FAILED
      elif [ -z "${MONITOR_UNIT:-}" ] || [ -z "${MONITOR_SERVICE_RESULT:-}" ] || [ -z "${MONITOR_EXIT_CODE:-}" ] || [ -z "${MONITOR_EXIT_STATUS:-}" ]; then event RETURN_MONITOR_MISSING
      elif [ "${MONITOR_UNIT:-}" != getty@tty1.service ]; then event RETURN_MONITOR_UNIT_MISMATCH
      elif [ "${MONITOR_SERVICE_RESULT:-}" != success ]; then event RETURN_SERVICE_RESULT_NOT_SUCCESS
      elif [ "${MONITOR_EXIT_CODE:-}" != exited ]; then event RETURN_EXIT_NOT_NORMAL
      else event RETURN_EXIT_NONZERO
      fi
      native_fallback
    fi
    ;;
  *)
    echo "Unknown tty1 route" >&2
    exit 2
    ;;
esac
