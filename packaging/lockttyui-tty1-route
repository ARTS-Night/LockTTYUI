#!/bin/sh
# Only root-owned systemd units call this helper. Never execute agetty here.
set -eu
PATH=/usr/sbin:/usr/bin:/sbin:/bin
export PATH
umask 077

event() { printf "LOCKTTYUI_EVENT=%s\n" "$1" >&2; }
state=/run
systemctl=/usr/bin/systemctl
token="$state/lockttyui-tty1-login.ready"
fallback="$state/lockttyui-tty1-fallback"
removing="$state/lockttyui-tty1-removing"
dropdir="$state/systemd/system/getty@tty1.service.d"
dropin="$dropdir/90-lockttyui-fallback.conf"
lockdir="$state/lockttyui-private"
# /run is root-owned; reject a pre-existing unsafe directory or symlink.
if [ -L "$lockdir" ]; then event ROUTE_LOCK_UNSAFE; exit 1; fi
if [ ! -d "$lockdir" ]; then mkdir -m 0700 "$lockdir" 2>/dev/null || [ -d "$lockdir" ] || exit 1; fi
if [ -L "$lockdir" ] || [ "$(stat -c '%u:%a' "$lockdir")" != "$(id -u):700" ]; then
  event ROUTE_LOCK_UNSAFE
  exit 1
fi
exec 9>"$lockdir/route.lock"
if ! /usr/bin/flock -w 3 9; then event ROUTE_LOCK_TIMEOUT; exit 1; fi

allowed() {
  [ ! -e "$removing" ] || return 1
  phase=$("$systemctl" is-system-running 2>/dev/null || :)
  case "$phase" in running|degraded|starting) ;; *) return 1 ;; esac
  return 0
}

start_getty() {
  allowed || return 0
  : > "$token"
  allowed || return 0
  event GETTY_START_REQUESTED
  if "$systemctl" --no-block start getty@tty1.service; then
    event GETTY_START_QUEUED
  else
    event GETTY_START_REQUEST_FAILED
    return 1
  fi
}

native_fallback() {
  allowed || return 0
  # Never change routing while getty may be serving a session or starting.
  current_getty=$("$systemctl" show -p ActiveState --value getty@tty1.service) || return 1
  case "$current_getty" in
    inactive|failed) ;;
    *) event GETTY_NOT_INACTIVE; return 0 ;;
  esac
  allowed || return 0
  event FALLBACK_SELECTED
  : > "$fallback"
  : > "$token"
  # Native restart, not a loop of OnSuccess/OnFailure callbacks. Only tty1
  # receives this ephemeral override; all vendor authentication commands stay.
  mkdir -p "$dropdir"
  tmp=$(mktemp "$dropdir/.lockttyui-fallback.XXXXXX")
  trap 'rm -f "$tmp"' EXIT
  cat > "$tmp" <<'CONF'
[Unit]
OnSuccess=
OnFailure=
# Preserve the tty1 unit's existing start-limit policy. This does not
# count LockTTYUI recovery attempts separately.

[Service]
Restart=always
RestartSec=3s
CONF
  allowed || return 0
  mv -f "$tmp" "$dropin"
  "$systemctl" daemon-reload
  allowed || return 0
  "$systemctl" reset-failed getty@tty1.service || :
  start_getty
}

allowed || exit 0

case "${1:-}" in
  handoff|fallback)
    current=$("$systemctl" show -p ActiveState --value lockttyui-tty1.service)
    case "$current" in inactive|failed) ;; *) event DASHBOARD_NOT_INACTIVE; exit 0 ;; esac
    if [ "$1" = fallback ] || [ -e "$fallback" ]; then
      native_fallback
    else
      start_getty
    fi
    ;;
  return)
    current=$("$systemctl" show -p ActiveState --value getty@tty1.service)
    case "$current" in inactive|failed) ;; *) event GETTY_NOT_INACTIVE; exit 0 ;; esac
    # systemd >=251 provides raw status to a handler of exactly one unit.
    # Missing, killed, or nonzero status is not a proven clean logout.
    if [ ! -e "$fallback" ] && [ "$current" = inactive ] &&
       [ "${MONITOR_UNIT:-}" = getty@tty1.service ] &&
       [ "${MONITOR_SERVICE_RESULT:-}" = success ] &&
       [ "${MONITOR_EXIT_CODE:-}" = exited ] &&
       [ "${MONITOR_EXIT_STATUS:-}" = 0 ]; then
      allowed || exit 0
      rm -f "$token"
      allowed || exit 0
      event DASHBOARD_START_REQUESTED
      if "$systemctl" --no-block start lockttyui-tty1.service; then
        event DASHBOARD_START_QUEUED
      else
        event DASHBOARD_START_REQUEST_FAILED
        exit 1
      fi
    else
      native_fallback
    fi
    ;;
  *)
    echo "Unknown tty1 route" >&2
    exit 2
    ;;
esac
