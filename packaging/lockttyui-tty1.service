[Unit]
Description=LockTTYUI pre-login telemetry on tty1
Documentation=man:systemd.service(5)
After=systemd-user-sessions.service plymouth-quit-wait.service getty-pre.target
After=getty@tty1.service
Before=getty.target
ConditionPathExists=!/run/lockttyui-tty1-login.ready
ConditionPathExists=!/run/lockttyui-tty1-fallback
ConditionPathExists=!/run/lockttyui-tty1-removing
OnSuccess=lockttyui-tty1-handoff.service
OnFailure=lockttyui-tty1-fallback.service
StartLimitIntervalSec=20s
StartLimitBurst=10

[Service]
Type=exec
User=nobody
Group=nobody
NoNewPrivileges=yes
CapabilityBoundingSet=
ProtectHome=yes
ProtectSystem=strict
PrivateTmp=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
StandardInput=tty-fail
StandardOutput=tty
StandardError=journal
TTYPath=/dev/tty1
# Never reset/hang up/disallocate a console that another session may own.
# Go restores its own termios; stock agetty resets the console after a crash.
TTYReset=no
TTYVHangup=no
TTYVTDisallocate=no
ExecStart=/usr/bin/lockttyui --exhibit --tty-fd
Restart=no
TimeoutStopSec=3s
TasksMax=32
MemoryHigh=96M
MemoryMax=192M
